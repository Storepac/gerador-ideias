# Server-side Gemini credential. Never expose this in NEXT_PUBLIC_* variables.
GEMINI_API_KEY=""

# Emergency kill switch. Set to "false" to pause every AI endpoint without a code deploy.
AI_ENABLED="true"

# Shared daily browser quota across Guide, Challenge and Content Lab.
# The value is signed server-side using a key derived from GEMINI_API_KEY.
AI_DAILY_LIMIT="3"

# Additional per-IP daily soft guard. Cloudflare's CF-Connecting-IP is preferred when present.
AI_IP_DAILY_LIMIT="12"
